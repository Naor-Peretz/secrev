#!/bin/sh
# Last check before anything leaves this machine.
#
# The full gate — pytest and the determinism check included — because a push is
# the point at which a mistake stops being local. pre-commit runs --fast so that
# committing stays cheap; this one runs everything, and it runs the same script
# CI will run, so a green push and a green CI are the same statement.
#
# Bypass with `git push --no-verify` when you mean to. It is not silent: CI runs
# the identical gate and will say so.
#
# stdin: <local ref> <local oid> <remote ref> <remote oid>, one line per ref.

set -eu
ROOT=$(git rev-parse --show-toplevel)
ZERO="0000000000000000000000000000000000000000"

# A push that only deletes refs changes no code. Nothing to verify.
pushing_code=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
    [ "$local_oid" = "$ZERO" ] || pushing_code=1
done
if [ "$pushing_code" = 0 ]; then
    exit 0
fi

printf '\033[1mpre-push: running the full gate\033[0m — the same one CI runs.\n'
printf 'Skip with --no-verify; CI will run it regardless.\n'

# `status=$?` after a bare `if … fi` reads the *if construct's* status, which is
# 0 when the condition failed and there is no else. It sat here for a while, and
# the effect was that the exit-2 branch below could never fire: a missing tool
# printed "the gate failed" and nothing about the environment, which is the one
# case where the code is fine and the message matters most. Verified in dash and
# bash before and after.
status=0
sh "$ROOT/scripts/check.sh" || status=$?
if [ "$status" = 0 ]; then
    exit 0
fi

printf '\n\033[31mpre-push: the gate failed — nothing was pushed.\033[0m\n' >&2
if [ "$status" = 2 ]; then
    printf 'Exit 2 means the environment could not check, not that the code is bad.\n' >&2
    printf 'The message above names the missing piece. The three setups are:\n' >&2
    printf '  python3 -m venv .venv && .venv/bin/pip install -e ".[dev]"\n' >&2
    printf '  python3 -m venv .venv-audit && .venv-audit/bin/pip install -r .github/requirements/audit.txt\n' >&2
    printf '  gitleaks — see CLAUDE.md, Development environment\n' >&2
fi
exit 1
